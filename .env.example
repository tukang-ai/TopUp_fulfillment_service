# ============================================================
# FULFILLMENT SERVICE — SERVER TOPUP
# Pasangan proyek ini: rust_backend (Server Web)
# Zero-inbound: tidak membuka port HTTP apa pun.
# Kunci enkripsi & grup Telegram WAJIB selaras antar keduanya.
# ============================================================

# Database Topup (MySQL / MariaDB) — TERPISAH dari database web
DATABASE_URL=mysql://user:password@localhost:3306/db_topup

# Supplier eksekusi topup
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_APIKEY=

# ============================================================
# TELEGRAM — bus komunikasi terenkripsi
# ============================================================
# Listener perintah order ([NEW_ORDER]/[REQ_OTP]/[VERIFY]/[API_ORDER])
TELEGRAM_BOT_2_TOKEN=
TELEGRAM_GROUP_2_ID=-100xxxxxxxxxx

# Listener mutasi GoPay
TELEGRAM_BOT_1_TOKEN=
TELEGRAM_GROUP_1_ID=-100xxxxxxxxxx

# BOT 3 — sinkronisasi harga/promo/voucher/level (fulfillment -> web)
TELEGRAM_BOT_3_TOKEN=
SYNC_INTERVAL_SECONDS=300

# Pengirim antrean batch keluar (round-robin 2 bot -> siklus 5 detik aman)
TELEGRAM_BOT_SENDER_TOKEN=
TELEGRAM_BOT_4_TOKEN=

# Kunci HMAC — WAJIB sama persis dengan rust_backend (Server Web)
TELEGRAM_ENCRYPTION_KEY=
# Opsional: fallback derivasi kunci bila ENCRYPTION_KEY kosong
# TELEGRAM_API_HASH=
